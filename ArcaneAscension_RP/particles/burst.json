{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count ?? 12"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(variable.speed ?? 4) * math.random(0.5, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -4,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.7)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size ?? 0.15) * (1 - variable.particle_age / variable.particle_lifetime)",
          "(variable.size ?? 0.15) * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
