{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:orb",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life ?? 0.35"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size ?? 0.25) * (1 - 0.6 * variable.particle_age / variable.particle_lifetime)",
          "(variable.size ?? 0.25) * (1 - 0.6 * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
