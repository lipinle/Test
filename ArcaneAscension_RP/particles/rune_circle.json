{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:rune_circle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_rune_circle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life ?? 1.5"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "variable.spin ?? 45"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.radius ?? 3",
          "variable.radius ?? 3"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(math.min(variable.particle_age * 6, (variable.particle_lifetime - variable.particle_age) * 4), 0, 0.9)"
        ]
      }
    }
  }
}
