{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count ?? 8"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius ?? 0.6",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.4)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size ?? 0.6) * (0.6 + 0.6 * variable.particle_age / variable.particle_lifetime)",
          "(variable.size ?? 0.6) * (0.6 + 0.6 * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 0.2",
          "variable.color.g ?? 0.1",
          "variable.color.b ?? 0.3",
          "0.7 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
