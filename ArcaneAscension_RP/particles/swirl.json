{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:swirl",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count ?? 10"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_disc": {
        "radius": "variable.radius ?? 2",
        "plane_normal": "y",
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_initial_speed": "(variable.radius ?? 2) * 1.6",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size ?? 0.18",
          "variable.size ?? 0.18"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
