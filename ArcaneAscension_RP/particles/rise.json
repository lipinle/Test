{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:rise",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count ?? 16"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_disc": {
        "radius": "variable.radius ?? 1",
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "(variable.speed ?? 2) * math.random(0.5, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.2)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size ?? 0.15) * (1 - 0.5 * variable.particle_age / variable.particle_lifetime)",
          "(variable.size ?? 0.15) * (1 - 0.5 * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
