{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arc:shards",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arc_shard"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count ?? 14"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(variable.speed ?? 5) * math.random(0.6, 1.1)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-200, 200)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 0.3,
        "collision_radius": 0.05,
        "collision_drag": 4
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size ?? 0.14",
          "variable.size ?? 0.14"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r ?? 1",
          "variable.color.g ?? 1",
          "variable.color.b ?? 1",
          "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
